<?xml version="1.0"?>
<ruleset name="SpeoReportPerformance">
    <description>PSR-12 for distributed plugin code and developer tooling.</description>
    <rule ref="PSR12"/>
    <file>.</file>
    <file>tests</file>
    <exclude-pattern>*/tests/Fixtures/*</exclude-pattern>
    <exclude-pattern>*/autoload-for-private-tests.php</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/lab/*</exclude-pattern>
    <exclude-pattern>*/.cache/*</exclude-pattern>
    <exclude-pattern>*/.matomo/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
