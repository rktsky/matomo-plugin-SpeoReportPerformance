{
  "name": "SpeoReportPerformance",
  "description": "Caches eligible flat monthly page URL reports while retaining Matomo permissions and report output.",
  "version": "1.2.3",
  "license": "GPL-3.0+",
  "keywords": [
    "performance",
    "cache",
    "page-reports"
  ],
  "homepage": "https://github.com/rktsky/matomo-plugin-SpeoReportPerformance",
  "authors": [
    {
      "name": "Rocketsky GmbH",
      "homepage": "https://www.rocketsky.ch/"
    }
  ],
  "support": {
    "issues": "https://github.com/rktsky/matomo-plugin-SpeoReportPerformance/issues",
    "source": "https://github.com/rktsky/matomo-plugin-SpeoReportPerformance",
    "docs": "https://github.com/rktsky/matomo-plugin-SpeoReportPerformance/blob/main/docs/index.md"
  },
  "require": {
    "matomo": ">=5.14.2,<6.0.0",
    "php": ">=8.4.0"
  },
  "wordpress-compatible": false,
  "onpremise-compatible": true,
  "category": "database",
  "archive": {
    "exclude": [
      "/tools",
      "/composer.json",
      "/composer.lock",
      "/phpcs.xml.dist",
      "/phpstan.neon",
      "/SPONSORS.md",
      "/MARKETPLACE.md"
    ]
  }
}
