{
    "name": "rocketsky/speo-report-performance",
    "description": "Developer tools for the SpeoReportPerformance Matomo plugin",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/run.php",
        "lint": "@php tests/lint.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "style": "phpcs -n",
        "style:fix": "phpcbf",
        "check": [
            "@lint",
            "@style",
            "@analyse",
            "@test"
        ]
    }
}
